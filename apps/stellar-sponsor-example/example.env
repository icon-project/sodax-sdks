# Copy to this app root; Vite does not read `src/.env`.
# Include any deployment version prefix; the SDK appends `/sponsorships/stellar/…`.
# VITE_SPONSORING_API_BASE_URL=

# Mock-only placeholder. Put real keys in an untracked `.env`; browser-bundled keys are public.
VITE_SPONSORING_API_KEY=mock-dev-key

# Explicitly exposes the real-mainnet lab switch in production.
# VITE_ENABLE_LAB=true
