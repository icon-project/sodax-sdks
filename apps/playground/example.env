# Copy to .env (gitignored) and fill in what you need. Every value is optional.
# Never commit real endpoints or project ids — these are placeholders only.

# Posture of this deployment. `full` (default) lets a connected wallet approve and swap on mainnet;
# `quote-only` hides every signing path, so the page can be embedded without risking real funds.
# VITE_PLAYGROUND_MODE=quote-only

# Per-chain RPC override, keyed by the ChainKeys constant name (see @sodax/types chain-keys.ts).
# Defaults come from @sodax/types spokeChainConfig — public endpoints that rate-limit under docs
# traffic, so set dedicated ones for any deployment that gets real visitors.
# VITE_RPC_SONIC_MAINNET=
# VITE_RPC_ARBITRUM_MAINNET=
# VITE_RPC_BASE_MAINNET=
# VITE_RPC_BSC_MAINNET=
# VITE_RPC_ETHEREUM_MAINNET=
# VITE_RPC_OPTIMISM_MAINNET=
# VITE_RPC_POLYGON_MAINNET=

# Enables WalletConnect-based wallets. Get a projectId at cloud.walletconnect.com.
# VITE_WALLETCONNECT_PROJECT_ID=
