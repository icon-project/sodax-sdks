# Copy to `.env`; all values are optional.
# Browser-visible `VITE_` values are public; never put secrets here.

# VITE_WALLETCONNECT_PROJECT_ID=

# Adds "Email (Privy)" to the EVM wallet list. Free app at dashboard.privy.io: enable Email login and Ethereum
# embedded wallets, and allow http://localhost:3000 plus any deployed origin. Privy refuses plain http on other
# hosts, so open the dev server on localhost, not the network address `--host` prints. The Settings modal
# can override it per browser; unset in both, the Privy chunk is never loaded.
# VITE_PRIVY_APP_ID=

# Include any deployment version prefix; the SDK appends `/sponsorships/stellar/…`.
# Unset uses the SDK's packaged production endpoint.
# VITE_SPONSORING_API_BASE_URL=http://localhost:3011

# Include any deployment version prefix; the SDK appends `/swaps/…`. Unset leaves swaps on the packaged
# production gateway, like every other service. Set it to reach canary (below) or a locally run
# `swaps-api`, which mounts those routes at the bare origin with no version prefix.
# VITE_SWAPS_API_BASE_URL=https://canary-api.sodax.com/v1

# Browser API keys are public; proxy through a backend if exposure is unacceptable.
# Keep real keys in the git-ignored `.env`, never in this file.
# Only needed for an independently hosted sponsoring service — on the packaged SODAX gateway
# VITE_SODAX_API_KEY covers sponsoring too. When set, this key wins for sponsoring calls.
# VITE_SPONSORING_API_KEY=

# Partner API key (issue #389) — becomes `new Sodax({ apiKey })`, the one instance-wide key sent as
# `x-api-key` on every backend API call (data, swaps, bridge, solver, and gateway-targeting
# sponsoring). Optional until the backend enforces it.
# VITE_SODAX_API_KEY=

# Bridge API host for the bridge-api showcase. A local bridge-api serves `/bridge/*` at the bare
# origin (no `/v1` prefix). Unset targets canary.
# VITE_BRIDGE_API_BASE_URL=http://localhost:3009

# Leverage Yield API host for the leverage-yield-api showcase. A local service serves
# `/leverage-yield/*` at the bare origin (no `/v1` prefix). Unset uses the packaged production API.
# VITE_LEVERAGE_YIELD_API_BASE_URL=http://localhost:3008

# VITE_DD_INTAKE_URL=
# VITE_SENTRY_DSN=
# VITE_SENTRY_TUNNEL=

# VITE_ENABLE_ANALYTICS=false
