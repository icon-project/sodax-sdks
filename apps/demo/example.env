# Copy to `.env`; all values are optional.
# Browser-visible `VITE_` values are public; never put secrets here.

# VITE_WALLETCONNECT_PROJECT_ID=

# Include any deployment version prefix; the SDK appends `/sponsorships/stellar/…`.
# Unset uses the SDK's packaged production endpoint.
# VITE_SPONSORING_API_BASE_URL=http://localhost:3011

# Include any deployment version prefix; the SDK appends `/swaps/…`. Unset targets canary; a
# locally run `swaps-api` mounts those routes at the bare origin, with no version prefix.
# VITE_SWAPS_API_BASE_URL=https://canary-api.sodax.com/v1

# Browser API keys are public; proxy through a backend if exposure is unacceptable.
# Keep real keys in the git-ignored `.env`, never in this file.
# VITE_SPONSORING_API_KEY=

VITE_ENABLE_OBSERVABILITY=true

# VITE_DD_INTAKE_URL=
# VITE_SENTRY_DSN=
# VITE_SENTRY_TUNNEL=

# VITE_ENABLE_ANALYTICS=false
